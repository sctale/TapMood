# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated bundles
test.bundle

# IDE / agent specs
.trae/
.claude/

# generated native folders
/ios
/android

# release signing (keystore + password, never commit)
/keystores/

# build outputs
*.apk
*.aab

# logs & temp
*.log
*.tmp
tapmood-ui-preview/

# release notes（发版临时说明文件，交付物统一留在项目目录）
release_notes*.md
